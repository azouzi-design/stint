{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "widget",
  "description": "What the timer page (loaded from the prototype site) may ask the shell to do.",
  "windows": ["widget"],
  "remote": {
    "urls": ["http://localhost:5174/*", "https://stint-prototype.vercel.app/*"]
  },
  "permissions": [
    "core:default",
    "core:window:allow-set-size",
    "core:window:allow-start-dragging",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-set-focus",
    "notification:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "https://stint-prototype.vercel.app/*" }, { "url": "http://localhost:5174/*" }]
    }
  ]
}
