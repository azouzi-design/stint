{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Stint",
  "version": "0.2.3",
  "identifier": "app.stint.desktop",
  "build": {
    "devUrl": "http://localhost:5174",
    "frontendDist": "https://stint-prototype.vercel.app"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQyOTI3QzFCRUMyRjg2RUIKUldUcmhpL3NHM3lTMGliZ0JUS3k2V0F6REg1VzQvOHNGSlVyWVE5OFh5NDh1a2l4NEJYdFB6N2UK",
      "endpoints": [
        "https://github.com/azouzi-design/stint/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    },
    "deep-link": {
      "desktop": {
        "schemes": [
          "stint"
        ]
      }
    }
  }
}
